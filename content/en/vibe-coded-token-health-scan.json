         \"priceCurrency\": \"USD\"\n          },\n          \"description\": \"A Web3-native tool that scans crypto tokens across 5 pillars: Security, Liquidity, Tokenomics, Community, and Development\"\n        }\n      },\n      {\n        \"@context\": \"https://schema.org\",\n        \"@type\": \"SoftwareApplication\",\n        \"name\": \"Token Health Scan\",\n        \"applicationCategory\": \"FinanceApplication\",\n        \"operatingSystem\": \"Web\",\n        \"offers\": {\n          \"@type\": \"Offer\",\n          \"price\": \"0\",\n          \"priceCurrency\": \"USD\"\n        },\n        \"aggregateRating\": {\n          \"@type\": \"AggregateRating\",\n          \"ratingValue\": \"4.8\",\n          \"reviewCount\": \"127\"\n        },\n        \"featureList\": [\n          \"Security analysis\",\n          \"Liquidity assessment\",\n          \"Tokenomics evaluation\",\n          \"Community metrics\",\n          \"Development activity tracking\",\n          \"Multi-chain support\",\n          \"Real-time alerts\"\n        ],\n        \"url\": \"https://tokenhealthscan.com\",\n        \"screenshot\": \"https://tokenhealthscan.com/screenshot.png\",\n        \"creator\": {\n          \"@type\": \"Person\",\n          \"name\": \"Gabriel Mangabeira\"\n        }\n      },\n      {\n        \"@context\": \"https://schema.org\",\n        \"@type\": \"FAQPage\",\n        \"mainEntity\": [\n          {\n            \"@type\": \"Question\",\n            \"name\": \"What is Token Health Scan?\",\n            \"acceptedAnswer\": {\n              \"@type\": \"Answer\",\n              \"text\": \"Token Health Scan is a free and pro-tier web app that lets anyone scan crypto tokens by name or address. It provides a 5-pillar health score covering Security, Liquidity, Tokenomics, Community, and Development to help users DYOR (Do Your Own Research).\"\n            }\n          },\n          {\n            \"@type\": \"Question\",\n            \"name\": \"How does Token Health Scan work?\",\n            \"acceptedAnswer\": {\n              \"@type\": \"Answer\",\n              \"text\": \"Users search for any token by name or address. The tool matches it in the CoinGecko database, runs comprehensive analysis across 5 pillars, and presents a detailed dashboard with overview scores and deep dive tabs. After 3 free scans, users can upgrade to Pro for unlimited access.\"\n            }\n          },\n          {\n            \"@type\": \"Question\",\n            \"name\": \"What technology powers Token Health Scan?\",\n            \"acceptedAnswer\": {\n              \"@type\": \"Answer\",\n              \"text\": \"Token Health Scan is built using Lovable (AI product builder) for the frontend, Supabase for the backend, Stripe for payments, and integrates multiple APIs including CoinGecko, GoPlus, GeckoTerminal, GitHub, and Apify/X for comprehensive token analysis.\"\n            }\n          },\n          {\n            \"@type\": \"Question\",\n            \"name\": \"What are the 5 pillars evaluated in Token Health Scan?\",\n            \"acceptedAnswer\": {\n              \"@type\": \"Answer\",\n              \"text\": \"The 5 pillars are: 1) Security - smart contract audits and vulnerabilities, 2) Liquidity - trading volume and depth, 3) Tokenomics - supply distribution and vesting, 4) Community - social engagement and growth, 5) Development - code activity and team transparency.\"\n            }\n          }\n        ]\n      },\n      {\n        \"@context\": \"https://schema.org\",\n        \"@type\": \"HowTo\",\n        \"name\": \"How to Build and Launch a Web3 Product with AI Tools\",\n        \"description\": \"Step-by-step guide to building Token Health Scan using no-code AI tools and launching with viral video marketing\",\n        \"step\": [\n          {\n            \"@type\": \"HowToStep\",\n            \"name\": \"Define the Problem\",\n            \"text\": \"Identify pain points in crypto research - too many tabs,