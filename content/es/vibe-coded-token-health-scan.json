 "content": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <meta name=\"description\" content=\"Cómo construí Token Health Scan - una herramienta Web3 para evaluar tokens cripto en 5 pilares. Conoce el stack tecnológico, estrategia de lanzamiento y el mockumentary con IA que se volvió viral.\">\n    <meta name=\"keywords\" content=\"Token Health Scan, análisis de tokens cripto, herramientas Web3, seguridad de tokens, DYOR cripto, análisis blockchain, lanzamiento de producto con IA, Lovable, herramientas cripto sin código\">\n    <meta name=\"author\" content=\"Gabriel Mangabeira\">\n    <link rel=\"canonical\" href=\"https://mangabeira.net/es/articulos/vibe-coded-token-health-scan\">\n    <link rel=\"alternate\" hreflang=\"en\" href=\"https://mangabeira.net/publications/vibe-coded-token-health-scan\">\n    <link rel=\"alternate\" hreflang=\"pt-BR\" href=\"https://mangabeira.net/br/artigos/vibe-coded-token-health-scan\">\n    <link rel=\"alternate\" hreflang=\"es\" href=\"https://mangabeira.net/es/articulos/vibe-coded-token-health-scan\">\n    \n    <!-- Open Graph / Social Media -->\n    <meta property=\"og:title\" content=\"Creé un Escáner de Salud de Tokens con IA (Y Lo Lancé con un Mockumentary)\">\n    <meta property=\"og:description\" content=\"Cómo construí Token Health Scan usando herramientas de IA y lo lancé con un anuncio mockumentary. Conoce el stack completo, recorrido del usuario y qué viene después.\">\n    <meta property=\"og:type\" content=\"article\">\n    <meta property=\"og:url\" content=\"https://mangabeira.net/es/articulos/vibe-coded-token-health-scan\">\n    <meta property=\"og:image\" content=\"https://mangabeira.net/assets/token-health-scan-cover.png\">\n    <meta property=\"og:locale\" content=\"es_ES\">\n    <meta property=\"og:locale:alternate\" content=\"en_US\">\n    <meta property=\"og:locale:alternate\" content=\"pt_BR\">\n 